# PostgreSQL ulanish manzili (Railway'da Postgres plugin avtomatik beradi)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# JWT imzolash kaliti: uzun tasodifiy qator (kamida 32 belgi)
JWT_SECRET="change-me-to-a-long-random-string"

# Ruxsat etilgan frontend originlari, vergul bilan ajratiladi, oxirida "/" siz
CORS_ORIGINS="http://localhost:5173"

# Port (Railway o'zi beradi, lokalda ixtiyoriy)
PORT=3000